#!/usr/bin/env bash
# wf-verify: universal project verifier for the agentic workflow.
# Runs the project's own verify.sh if present, otherwise detects stack and
# runs build/typecheck/test/lint. Exits non-zero on any failure.
set -uo pipefail

if [ "${1:-}" = "-v" ] || [ "${1:-}" = "--version" ]; then
  echo "wf-verify 0.2.0"
  exit 0
fi
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "wf-verify [path]  - universal project verifier"
  echo "  runs verify.sh if present, else detects Go/Bun/Node/Rust/Python/Make"
  exit 0
fi
DIR="${1:-.}"
cd "$DIR" 2>/dev/null || { echo "wf-verify: cannot cd to $DIR"; exit 2; }
ROOT="$(pwd)"

run() { echo ">> $*"; "$@"; }

echo "wf-verify: project=$ROOT"

# 1. Prefer project's own verify.sh
if [ -x "$ROOT/verify.sh" ]; then
  echo "== verify.sh =="
  "$ROOT/verify.sh"
  rc=$?
  echo "wf-verify: verify.sh exit=$rc"
  exit $rc
fi
if [ -f "$ROOT/verify.sh" ]; then
  echo "== verify.sh (bash) =="
  bash "$ROOT/verify.sh"
  rc=$?
  echo "wf-verify: verify.sh exit=$rc"
  exit $rc
fi

# 2. Go
if [ -f "$ROOT/go.mod" ]; then
  echo "== go =="
  # gofmt check
  bad=$(gofmt -l . 2>/dev/null)
  if [ -n "$bad" ]; then echo "gofmt unformatted:"; echo "$bad"; exit 1; fi
  run go vet ./... || exit 1
  run go build ./... || exit 1
  if ls *_test.go >/dev/null 2>&1 || find . -name '*_test.go' | grep -q .; then
    run go test ./... || exit 1
  fi
  echo "wf-verify: go OK"
  exit 0
fi

# 3. Bun / Node (package.json)
if [ -f "$ROOT/package.json" ]; then
  if [ -f "$ROOT/bun.lock" ] || [ -f "$ROOT/bun.lockb" ]; then
    PM=bun
  elif command -v bun >/dev/null 2>&1 && [ -f "$ROOT/bunfig.toml" ]; then
    PM=bun
  else
    PM=npm
  fi
  echo "== $PM (package.json) =="
  # typecheck
  if [ "$PM" = "bun" ]; then
    if grep -q '"typecheck"' package.json; then run bun run typecheck || exit 1; fi
    if grep -q '"check"' package.json; then run bun run check || exit 1; fi
    if grep -q '"test"' package.json; then run bun test || exit 1; fi
    if grep -q '"build"' package.json; then run bun run build || exit 1; fi
    if [ -f "biome.json" ] || [ -f "biome.jsonc" ]; then run bunx biome check . || exit 1; fi
  else
    if grep -q '"typecheck"' package.json; then run npm run typecheck || exit 1; fi
    if grep -q '"check"' package.json; then run npm run check || exit 1; fi
    if grep -q '"test"' package.json; then run npm test || exit 1; fi
    if grep -q '"build"' package.json; then run npm run build || exit 1; fi
    if [ -f ".eslintrc" ] || [ -f ".eslintrc.js" ] || [ -f "eslint.config.js" ] || [ -f "eslint.config.mjs" ]; then run npx eslint . || exit 1; fi
  fi
  echo "wf-verify: $PM OK"
  exit 0
fi

# 3b. Rust (Cargo.toml)
if [ -f "$ROOT/Cargo.toml" ]; then
  echo "== cargo =="
  if command -v cargo >/dev/null 2>&1; then
    run cargo fmt --check || exit 1
    run cargo check || exit 1
    if command -v cargo-clippy >/dev/null 2>&1 || cargo clippy --version >/dev/null 2>&1; then
      cargo clippy -- -D warnings >/tmp/opencode/clippy.log 2>&1 && echo "clippy: ok" || { cat /tmp/opencode/clippy.log | tail -5; } 
    fi
    if grep -q '\[\[test\]\]\|\[dev-dependencies\]' "$ROOT/Cargo.toml" 2>/dev/null || find . -name '*.rs' | xargs grep -l '#\[test\]' >/dev/null 2>&1; then
      run cargo test || exit 1
    fi
    echo "wf-verify: cargo OK"
    exit 0
  else
    echo "wf-verify: cargo not installed; skip"
  fi
fi

# 3c. Deno
if [ -f "$ROOT/deno.json" ] || [ -f "$ROOT/deno.jsonc" ]; then
  echo "== deno =="
  if command -v deno >/dev/null 2>&1; then
    run deno check . 2>/dev/null || true
    if find . -name '*_test.ts' -o -name '*_test.js' | grep -q .; then run deno test || exit 1; fi
    echo "wf-verify: deno OK"
    exit 0
  else
    echo "wf-verify: deno not installed; skip"
  fi
fi

# 3d. Ruby
if [ -f "$ROOT/Gemfile" ]; then
  echo "== ruby =="
  if command -v bundle >/dev/null 2>&1; then
    if [ -f "$ROOT/Rakefile" ]; then run bundle exec rake || exit 1; fi
    if ls spec/*_spec.rb >/dev/null 2>&1; then run bundle exec rspec || exit 1; fi
    echo "wf-verify: ruby OK"
    exit 0
  else
    echo "wf-verify: bundler not installed; skip"
  fi
fi

# 3e. Makefile fallback
if [ -f "$ROOT/Makefile" ] && grep -qE '^(test|check|verify|build):' "$ROOT/Makefile"; then
  echo "== make =="
  if grep -q '^verify:' "$ROOT/Makefile"; then run make verify || exit 1
  elif grep -q '^check:' "$ROOT/Makefile"; then run make check || exit 1
  else
    grep -q '^build:' "$ROOT/Makefile" && { run make build || exit 1; }
    grep -q '^test:' "$ROOT/Makefile" && { run make test || exit 1; }
  fi
  echo "wf-verify: make OK"
  exit 0
fi

# 3f. Standalone TypeScript (tsconfig.json, no package.json)
if [ -f "$ROOT/tsconfig.json" ] && [ ! -f "$ROOT/package.json" ]; then
  echo "== tsc =="
  if command -v tsc >/dev/null 2>&1; then
    run tsc --noEmit || exit 1
    echo "wf-verify: tsc OK"
    exit 0
  elif command -v npx >/dev/null 2>&1; then
    run npx tsc --noEmit || exit 1
    echo "wf-verify: tsc OK"
    exit 0
  else
    echo "wf-verify: tsc not available; skip"
  fi
fi

# 3g. PHP (composer)
if [ -f "$ROOT/composer.json" ]; then
  echo "== php/composer =="
  if command -v php >/dev/null 2>&1; then
    if [ -f "$ROOT/vendor/bin/phpunit" ]; then run "$ROOT/vendor/bin/phpunit" || exit 1; fi
    if [ -f "$ROOT/phpunit.xml" ] || [ -f "$ROOT/phpunit.xml.dist" ]; then
      if command -v phpunit >/dev/null 2>&1; then run phpunit || exit 1; fi
    fi
    echo "wf-verify: php OK"
    exit 0
  else
    echo "wf-verify: php not installed; skip"
  fi
fi

# 4. Python
if [ -f "$ROOT/pyproject.toml" ] || [ -f "$ROOT/setup.py" ]; then
  echo "== python =="
  if [ -f "$ROOT/pytest.ini" ] || find . -name 'test_*.py' -o -name '*_test.py' | grep -q .; then
    if command -v python3 >/dev/null 2>&1; then
      if python3 -c "import pytest" 2>/dev/null; then run python3 -m pytest -q || exit 1
      else echo "wf-verify: pytest not installed; skip python tests"; fi
    elif command -v python >/dev/null 2>&1; then
      if python -c "import pytest" 2>/dev/null; then run python -m pytest -q || exit 1
      else echo "wf-verify: pytest not installed; skip python tests"; fi
    else echo "wf-verify: python tests present but no interpreter"; exit 1
    fi
  fi
  echo "wf-verify: python OK"
  exit 0
fi

echo "wf-verify: no recognized project (no verify.sh/go.mod/package.json). Nothing to do."
exit 0